# Terraform directories and generated files
.terraform/
.terraform.lock.hcl

# State files (contain sensitive data)
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Sensitive variable files
terraform.tfvars
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
